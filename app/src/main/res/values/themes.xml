<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Canastra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/table_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Canastra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/felt</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Canastra</item>
    </style>
</resources>
